# Backend Environment Variables Configuration
# Copy this file to .env and fill in the actual values

# Server Configuration
PORT=3000

# MongoDB Configuration
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname?appName=appName
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=resumeclientdata

# JWT Secret (use a strong random string)
JWT_SECRET=your_jwt_secret_here_use_a_strong_random_string

# ImageKit Configuration (Required for image uploads)
# Get these from https://imagekit.io/dashboard/settings/api-keys
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# OpenAI Configuration (Required for AI features)
# Using Google Generative AI (Gemini) as example
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3-flash-preview
